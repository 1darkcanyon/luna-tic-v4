<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nexus_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/titleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LUNA-TIC"
            android:textColor="@color/nexus_cyan"
            android:textSize="28sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="20dp"
            android:text="@string/tagline"
            android:textColor="@color/nexus_text_secondary"
            android:textSize="13sp" />

        <!-- Moon phase card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/nexus_surface"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/phaseNameText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="—"
                android:textColor="@color/nexus_teal"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/illuminationText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/nexus_text_primary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/gravIndexText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/nexus_gold"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/nextFullMoonText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/nexus_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Numerology card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/nexus_surface"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Daily Vibration"
                android:textColor="@color/nexus_magenta"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/dailyVibrationText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/nexus_text_primary"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Tarot card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/nexus_surface"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Daily Draw"
                android:textColor="@color/nexus_cyan"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tarotCardText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/nexus_text_primary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tarotKeywordText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/nexus_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Journal entry -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/nexus_surface"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Journal Entry"
                android:textColor="@color/nexus_teal"
                android:textSize="16sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/moodScoreInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:hint="Mood (1-10)"
                android:inputType="number"
                android:textColor="@color/nexus_text_primary"
                android:textColorHint="@color/nexus_text_secondary" />

            <EditText
                android:id="@+id/noteInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="How are you feeling today?"
                android:inputType="textMultiLine"
                android:minLines="2"
                android:textColor="@color/nexus_text_primary"
                android:textColorHint="@color/nexus_text_secondary" />

            <Button
                android:id="@+id/saveEntryButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Save Entry"
                android:backgroundTint="@color/nexus_cyan"
                android:textColor="@color/nexus_bg" />
        </LinearLayout>

        <!-- Journal history -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Recent Entries"
            android:textColor="@color/nexus_text_secondary"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/journalHistoryText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/nexus_text_secondary"
            android:textSize="12sp"
            android:lineSpacingExtra="4dp" />

    </LinearLayout>
</ScrollView>
